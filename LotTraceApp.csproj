<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
	<PlatformTarget>x86</PlatformTarget>
	<UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>LotTraceApp</RootNamespace>
    <AssemblyName>LotTraceApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Config\FilterTable.csv" />
    <None Remove="Config\SingleControlProcessTable.csv" />
    <None Remove="LotTraceApp.ini" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\FilterTable.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\SingleControlProcessTable.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="LotTraceApp.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

</Project>